---
import { tools } from '../data/profile';
import { getLang, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="herramientas" class="pt-16 md:pt-24" aria-labelledby="herramientas-title">
  <SectionHeading id="herramientas-title" eyebrow={t('tools.eyebrow')} title={t('tools.title')} lead={t('tools.lead')} />
  <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-4">
    {
      tools.map(({ group, items }) => (
        <div class="reveal card p-5">
          <h3 class="mb-3 text-[0.9375rem] font-semibold text-fg">{group[lang]}</h3>
          <ul class="flex flex-wrap gap-1.5">
            {items.map((item) => (
              <li class="rounded-md border border-line-strong bg-bg px-2.5 py-1 font-mono text-[0.8125rem] text-fg-2">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
