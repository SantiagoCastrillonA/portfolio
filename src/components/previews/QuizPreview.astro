---
import { getLang } from '../../i18n/utils';

const copy = {
  es: {
    meta: 'sesión 06 · css · ejercicio 12/19',
    question: '¿Qué propiedad separa el contenido del borde?',
    correct: '✓ correcto',
    saved: 'progreso guardado en servidor',
  },
  en: {
    meta: 'session 06 · css · exercise 12/19',
    question: 'Which property separates content from the border?',
    correct: '✓ correct',
    saved: 'progress saved on the server',
  },
}[getLang(Astro.currentLocale)];

const option = 'rounded-md border px-3.5 py-2.5 font-mono text-[0.8125rem]';
---

<div class="flex flex-col gap-2.5 bg-bg p-5 md:p-7" aria-hidden="true">
  <p class="font-mono text-xs text-muted">{copy.meta}</p>
  <p class="mb-1 font-mono text-[0.9375rem] font-bold text-fg md:text-base">{copy.question}</p>
  <div class:list={[option, 'border-line-strong text-fg-2']}>a) margin</div>
  <div class:list={[option, 'border-accent bg-accent/10 text-accent']}>b) padding {copy.correct}</div>
  <div class:list={[option, 'border-line-strong text-fg-2']}>c) border-spacing</div>
  <div class="mt-2 h-1 rounded-sm bg-line"><div class="h-1 w-[63%] rounded-sm bg-accent"></div></div>
  <p class="font-mono text-[0.6875rem] text-muted">{copy.saved}</p>
</div>
