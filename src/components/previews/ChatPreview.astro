---
import { getLang } from '../../i18n/utils';

const copy = {
  es: { visitor: 'Hola, necesito info de un pedido', agent: 'Ya te atiende un asesor' },
  en: { visitor: 'Hi, I need info about an order', agent: 'An advisor will help you now' },
}[getLang(Astro.currentLocale)];
---

<div class="flex flex-col gap-2 border-b border-line bg-bg px-5 py-[18px]" aria-hidden="true">
  <div class="max-w-[80%] self-start rounded-[10px_10px_10px_2px] border border-line-strong px-[11px] py-1.5 text-[0.8125rem] text-fg-2">
    {copy.visitor}
  </div>
  <div class="max-w-[80%] self-end rounded-[10px_10px_2px_10px] bg-accent px-[11px] py-1.5 text-[0.8125rem] font-medium text-bg">
    {copy.agent}
  </div>
  <span class="self-end font-mono text-[0.6875rem] text-muted">ws:// conectado</span>
</div>
