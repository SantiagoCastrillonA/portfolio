---
import { process, services } from '../data/services';
import { getLang, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Simple line icons, one per service.
const icons = {
  web: 'M3 5h18v12H3zM8 21h8M12 17v4',
  dashboard: 'M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z',
  chat: 'M21 12a8 8 0 0 1-11.6 7.1L4 21l1.9-5.4A8 8 0 1 1 21 12Z',
  ai: 'M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9ZM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8Z',
};
---

<section id="servicios" class="pt-16 md:pt-24" aria-labelledby="servicios-title">
  <SectionHeading id="servicios-title" eyebrow={t('services.eyebrow')} title={t('services.title')} lead={t('services.lead')} />

  <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-4">
    {
      services.map((service) => (
        <li class="reveal card flex flex-col gap-3 p-6">
          <span class="flex size-11 items-center justify-center rounded-lg bg-accent/12 text-accent" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round">
              <path d={icons[service.icon]} />
            </svg>
          </span>
          <h3 class="text-lg leading-snug font-semibold text-fg">{service.title[lang]}</h3>
          <p class="text-[0.9375rem] text-fg-2">{service.description[lang]}</p>
          <p class="mt-auto border-t border-line pt-3 text-[0.8125rem] text-muted">
            <span class="font-mono text-accent">{t('services.example')}:</span> {service.example[lang]}
          </p>
        </li>
      ))
    }
  </ul>

  <h3 class="mt-14 mb-6 font-mono text-xl font-bold md:text-2xl">{t('process.title')}</h3>
  <ol class="grid grid-cols-2 gap-px md:grid-cols-[repeat(auto-fit,minmax(220px,1fr))] overflow-hidden rounded-[10px] border border-line bg-line">
    {
      process.map((step, i) => (
        <li class="reveal flex flex-col gap-2 bg-surface p-4 md:p-6">
          <span class="font-mono text-sm font-bold text-accent" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="font-semibold text-fg">{step.title[lang]}</p>
          <p class="text-[0.9375rem] text-fg-2">{step.description[lang]}</p>
        </li>
      ))
    }
  </ol>
</section>
