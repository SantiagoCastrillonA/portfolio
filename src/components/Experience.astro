---
import { getCollection } from 'astro:content';
import { getLang, useTranslations } from '../i18n/utils';
import SectionHeading from './SectionHeading.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const entries = (await getCollection('experience', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);

const dotClass = {
  work: 'bg-accent',
  mentoring: 'bg-violet',
  education: 'border-2 border-muted',
};
const kindClass = { work: 'text-accent', mentoring: 'text-violet', education: 'text-muted' };
---

<section id="experiencia" class="pt-16 md:pt-24" aria-labelledby="experiencia-title">
  <SectionHeading id="experiencia-title" eyebrow={t('experience.eyebrow')} title={t('experience.title')} />
  <ol class="card py-2">
    {
      entries.map(({ data }, i) => (
        <li class="reveal flex gap-4 border-line px-4 py-5 not-last:border-b md:gap-5 md:px-6">
          <div class="flex flex-col items-center pt-1.5" aria-hidden="true">
            <span class:list={['size-3 shrink-0 rounded-full', dotClass[data.kind]]} />
            {i < entries.length - 1 && <span class="mt-1.5 w-0.5 grow bg-line-strong" />}
          </div>
          <div class="min-w-0 grow">
            <p class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem]">
              <span class:list={['font-mono font-medium tracking-[.06em] uppercase', kindClass[data.kind]]}>
                {t(`experience.kind.${data.kind}`)}
              </span>
              <span class="text-muted">{data.period}</span>
              {data.current && (
                <span class="rounded-full bg-accent/12 px-2 py-0.5 text-xs font-medium text-accent">
                  {t('experience.current')}
                </span>
              )}
            </p>
            <h3 class="text-lg leading-snug font-semibold md:text-xl">{data.role}</h3>
            <p class="mb-2 text-[0.9375rem] text-fg-2">{data.org}</p>
            <p class="max-w-[72ch] text-[0.9375rem] text-fg-2">{data.summary}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
