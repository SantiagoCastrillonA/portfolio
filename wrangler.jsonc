{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "portfolio",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Public values. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY) go in
  // `wrangler secret put` for production and in .dev.vars locally.
  "vars": {
    "CONTACT_TO": "santiago.castrillon.ar@gmail.com",
    "CONTACT_FROM": "Portafolio <onboarding@resend.dev>"
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
